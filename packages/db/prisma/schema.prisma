generator client {
  provider = "prisma-client-js"
  output   = "../client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Foydalanuvchilar ============

enum UserRole {
  MERCHANT // do'kon egasi
  ADMIN // LYNKO-X platforma administratori
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(MERCHANT)
  adminRole    AdminRole? // faqat role = ADMIN uchun: huquqlar darajasi
  createdAt    DateTime @default(now())
  stores       Store[]
  planPayments PlanPayment[] // admin sifatida yozgan to'lovlari
  storeNotes   StoreNote[]
  auditLogs    AuditLog[]    @relation("AuditActor")
}

// LYNKO-X jamoasi huquqlari
enum AdminRole {
  OWNER // hamma narsa, jamoani boshqarish
  SUPPORT // ko'rish, bloklash, izohlar
  FINANCE // ko'rish, tariflar va to'lovlar
}

// ============ Tenant: har bir do'kon ============

enum StorePlan {
  FREE // 10 tagacha mahsulot
  BASIC // 100 tagacha mahsulot
  PRO // cheksiz
}

model Store {
  id               String     @id @default(cuid())
  slug             String     @unique // subdomen: {slug}.lynko-x.uz — hozircha /{slug}
  name             String
  description      String?
  phone            String?
  telegram         String?
  logoUrl          String?
  currency         String     @default("UZS")
  locale           String     @default("uz")
  deliveryFee      Int        @default(0) // so'mda
  plan             StorePlan  @default(FREE)
  planExpiresAt    DateTime? // pullik tarif yoki sinov muddati; null = muddatsiz
  isTrial          Boolean    @default(false) // sinov davri (bepul berilgan pullik tarif)
  theme            String     @default("classic") // vitrina shabloni: classic | minimal | bold | elegant | market
  bannerUrl        String? // hero-bo'lim uchun banner rasmi
  brandColor       String? // sotuvchining brend rangi (#rrggbb); null = shablonning standart rangi
  telegramBotToken String? // yangi buyurtma bildirishnomalari uchun
  telegramChatId   String?
  isActive         Boolean    @default(true)
  blockReason      String? // owner-panel: nima uchun bloklangan
  blockedAt        DateTime?
  ownerId          String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products    Product[]
  categories  Category[]
  orders      Order[]
  planPayments PlanPayment[]
  notes       StoreNote[]
  auditLogs   AuditLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ============ Owner-panel: ichki izohlar va audit-jurnal ============

model StoreNote {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  text      String
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

// Kim, qachon, nima qildi. Owner-panel amallari va tizim voqealari.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String
  actorRole  String // OWNER | SUPPORT | FINANCE | MERCHANT | SYSTEM
  action     String // masalan: store.blocked, payment.added
  entity     String // store | payment | note | admin | order
  entityId   String?
  storeId    String?
  store      Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([storeId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

// ============ Obuna to'lovlari (hozircha qo'lda, keyin Payme/Click) ============

enum PlanPaymentMethod {
  CASH // naqd
  CARD // karta
  TRANSFER // bank o'tkazmasi
  OTHER
}

model PlanPayment {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan        StorePlan
  amount      Int // so'mda
  method      PlanPaymentMethod @default(TRANSFER)
  months      Int               @default(1)
  paidAt      DateTime          @default(now())
  periodStart DateTime
  periodEnd   DateTime
  note        String?
  createdById String? // qaysi admin yozgan
  createdBy   User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([storeId, paidAt])
  @@index([paidAt])
}

model Category {
  id       String    @id @default(cuid())
  storeId  String
  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  products Product[]

  @@unique([storeId, slug])
}

model Product {
  id           String           @id @default(cuid())
  storeId      String
  store        Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name         String
  slug         String
  description  String?
  price        Int // so'mda (UZS tiyin ishlatilmaydi)
  comparePrice Int? // chegirmagacha bo'lgan narx
  stock        Int              @default(0) // variantlari bo'lsa, ombor variantlar bo'yicha yuritiladi
  images       String[]
  isActive     Boolean          @default(true)
  variants     ProductVariant[]
  orderItems   OrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([storeId, slug])
  @@index([storeId, isActive])
}

// Variant: bitta mahsulotning rang/o'lcham kabi turlari.
// price = null bo'lsa, mahsulotning asosiy narxi amal qiladi.
model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // masalan: "Qizil / L"
  price      Int?
  stock      Int         @default(0)
  sortOrder  Int         @default(0)
  orderItems OrderItem[]

  @@index([productId])
}

// ============ Buyurtmalar ============

enum OrderStatus {
  NEW
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE_MOCK
  PAYME
  CLICK
}

model Order {
  id            String        @id @default(cuid())
  number        Int // do'kon ichida tartib raqam: #1001, #1002...
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status        OrderStatus   @default(NEW)
  paymentStatus PaymentStatus @default(PENDING)
  paymentMethod PaymentMethod
  customerName  String
  phone         String
  address       String?
  note          String?
  subtotal      Int
  deliveryFee   Int           @default(0)
  total         Int
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([storeId, number])
  @@index([storeId, status])
}

model OrderItem {
  id        String          @id @default(cuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name      String // buyurtma paytidagi nom (snapshot, variant nomi bilan)
  price     Int // buyurtma paytidagi narx (snapshot)
  quantity  Int
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String // "mock" | "payme" | "click"
  amount        Int
  status        PaymentStatus @default(PENDING)
  providerTxnId String?
  raw           Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
